{
  "name": "eve-buyer",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "deploy": "eve deploy",
    "dev": "eve dev",
    "eval": "eve eval",
    "start": "eve start",
    "typecheck": "tsc",
    "serve": "set -a && . ./.env && set +a && eve dev --no-ui --port 3200",
    "ask": "node run.mjs"
  },
  "dependencies": {
    "@vercel/connect": "2.2.0",
    "ai": "^7.0.105",
    "eve": "^0.71.0",
    "mppx": "0.13.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
